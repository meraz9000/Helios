# Domain pointing to your DigitalOcean droplet's IPv4 address (A record)
HELIOS_PUBLIC_HOST=relay.yourdomain.com

# UDP port for QUIC NAT discovery & encrypted QUIC relay fallback (default 3478)
HELIOS_UDP_PORT=3478

# Optional one-time/bootstrap token for initial device pairing (clear after pairing!)
HELIOS_BOOTSTRAP_TOKEN=

RUST_LOG=info
